+  // SDL reports finger positions normalized to the window; listeners (imgui,
+  // touch controls) work in physical pixels like mouse events do.
+  // Only touchscreens: macOS trackpads also report (indirect) fingers, which
+  // must keep acting as a mouse rather than as taps at absolute positions.
+  if (SDL_GetTouchDeviceType(event.touchID) != SDL_TOUCH_DEVICE_DIRECT) {
+    return;
+  }
+  int width = 0;
+  int height = 0;
+  if (!window_ || !SDL_GetWindowSizeInPixels(window_, &width, &height)) {
+    return;
+  }
+  TouchEvent::Action action = TouchEvent::Action::kMove;
+  switch (type) {
+    case SDL_EVENT_FINGER_DOWN:
+      action = TouchEvent::Action::kDown;
+      break;
+    case SDL_EVENT_FINGER_UP:
+      action = TouchEvent::Action::kUp;
+      break;
+    case SDL_EVENT_FINGER_CANCELED:
+      action = TouchEvent::Action::kCancel;
+      break;
+    default:
+      break;
+  }
+  // Finger IDs are only unique while down; the low 32 bits are enough to tell
+  // concurrent fingers apart. kPointerIDNone is reserved.
+  uint32_t pointer_id = uint32_t(event.fingerID);
+  if (pointer_id == TouchEvent::kPointerIDNone) {
+    pointer_id = 0;
+  }
+  TouchEvent e(this, pointer_id, action, event.x * float(width), event.y * float(height));
+  OnTouchEvent(e, destruction_receiver);
+}
