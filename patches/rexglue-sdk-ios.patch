+#==========================================================
+# rexglue_configure_ios_target(<target>) - iOS link setup
+#
+# The runtime is a static archive on iOS. Its kernel export tables and cvars
+# register through static initializers nothing references directly, so it is
+# linked whole-archive. MoltenVK is linked statically from an xcframework
+# (Vulkan SDK: <sdk>/iOS/lib/MoltenVK.xcframework, or a MoltenVK release's
+# MoltenVK/static/MoltenVK.xcframework).
+#==========================================================
+set(REXGLUE_MOLTENVK_XCFRAMEWORK "" CACHE PATH
+    "iOS: path to a static MoltenVK.xcframework")
+
+function(rexglue_configure_ios_target target_name)
+    target_link_libraries(${target_name} PRIVATE
+        "$<LINK_LIBRARY:WHOLE_ARCHIVE,rexruntime>")
+
+    set(_mvk_candidates)
+    if(REXGLUE_MOLTENVK_XCFRAMEWORK)
+        list(APPEND _mvk_candidates "${REXGLUE_MOLTENVK_XCFRAMEWORK}")
+    endif()
+    if(DEFINED ENV{VULKAN_SDK})
+        list(APPEND _mvk_candidates
+            "$ENV{VULKAN_SDK}/../iOS/lib/MoltenVK.xcframework"
+            "$ENV{VULKAN_SDK}/iOS/lib/MoltenVK.xcframework")
+    endif()
+    set(_mvk_lib "")
+    foreach(_xcf ${_mvk_candidates})
+        foreach(_slice ios-arm64 ios-arm64_arm64e)
+            if(EXISTS "${_xcf}/${_slice}/libMoltenVK.a")
+                set(_mvk_lib "${_xcf}/${_slice}/libMoltenVK.a")
+                break()
+            endif()
+        endforeach()
+        if(_mvk_lib)
+            break()
+        endif()
+    endforeach()
+    if(NOT _mvk_lib)
+        message(FATAL_ERROR
+            "iOS build needs a static MoltenVK. Set REXGLUE_MOLTENVK_XCFRAMEWORK to a "
+            "MoltenVK.xcframework containing ios-arm64/libMoltenVK.a (ios/fetch-moltenvk.sh "
+            "downloads one), or set VULKAN_SDK to an installed LunarG Vulkan SDK.")
+    endif()
+    message(STATUS "iOS MoltenVK: ${_mvk_lib}")
+    target_link_libraries(${target_name} PRIVATE
+        "${_mvk_lib}"
+        "-framework Metal"
+        "-framework QuartzCore"
+        "-framework IOSurface"
+        "-framework UIKit"
+        "-framework Foundation"
+        "-framework CoreGraphics"
+        "-framework GameController"
+        "-framework UniformTypeIdentifiers"
+        "-framework AVFoundation"
+        c++)
+endfunction()
+
