<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Raises the jetsam memory ceiling so the 512 MiB guest RAM, the
	     recompiled image and GPU resources fit on 6-8 GB devices. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
@SKATE3_IOS_EXTRA_ENTITLEMENTS@</dict>
</plist>
